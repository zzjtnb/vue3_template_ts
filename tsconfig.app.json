{
  "extends": "@vue/tsconfig/tsconfig.web.json",
  "include": [
    "types/**/*",
    "types/**/*.d.ts",
    "src/**/*",
    "src/**/*.vue",
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "vite/client",
      "element-plus/global"
    ],
  }
}
