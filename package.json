{
  "name": "vue3_template_ts",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "preinstall": "node .husky/preinstall.js",
    "prepare": "husky install",
    "lint:eslint": "eslint --cache --cache-location .cache/eslint/  \"src/**/*.{js,ts,cjs,vue}\" --fix --ignore-path .gitignore",
    "lint:prettier": "prettier --write  \"src/**/*.(js|ts|cjs|json|css|scss|vue|html)\"",
    "lint:stylelint": "stylelint --cache --cache-location .cache/stylelint/ --fix \"src/**/*.(vue|scss|css)\" ",
    "lint:lint-staged": "lint-staged -c ./.husky/lintstagedrc.js",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "commit": "git-cz"
  },
  "engines": {
    "node": ">= 16",
    "pnpm": ">= 6"
  },
  "browserslist": [
    "> 1%",
    "not ie 11",
    "not op_mini all"
  ],
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".husky/cz-config.js"
    }
  },
  "dependencies": {
    "@vueuse/core": "^9.4.0",
    "axios": "^1.1.3",
    "dayjs": "^1.11.6",
    "element-plus": "^2.2.19",
    "pinia": "^2.0.23",
    "pinia-plugin-persist": "^1.0.0",
    "vue": "^3.2.41",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.2.0",
    "@commitlint/config-conventional": "^17.2.0",
    "@iconify-json/ep": "^1.1.8",
    "@iconify-json/noto": "^1.1.5",
    "@playwright/test": "^1.27.1",
    "@types/jsdom": "^20.0.0",
    "@types/node": "^16.11.68",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "@vitejs/plugin-legacy": "^2.3.0",
    "@vitejs/plugin-vue": "^3.1.2",
    "@vue/test-utils": "^2.1.0",
    "@vue/tsconfig": "^0.1.3",
    "commitizen": "^4.2.5",
    "commitlint-config-cz": "^0.13.3",
    "cz-customizable": "^7.0.0",
    "eslint": "^8.26.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-define-config": "^1.11.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.7.0",
    "husky": "^8.0.0",
    "jsdom": "^20.0.1",
    "lint-staged": "^13.0.3",
    "npm-run-all": "^4.1.5",
    "postcss-html": "^1.5.0",
    "prettier": "^2.7.1",
    "sass": "^1.55.0",
    "stylelint": "^14.14.0",
    "stylelint-config-idiomatic-order": "^9.0.0",
    "stylelint-config-prettier-scss": "^0.0.1",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard-scss": "^6.0.0",
    "typescript": "~4.7.4",
    "unplugin-auto-import": "^0.11.4",
    "unplugin-icons": "^0.14.13",
    "unplugin-vue-components": "^0.22.9",
    "vite": "^3.1.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-inspect": "^0.7.7",
    "vitest": "^0.24.3",
    "vue-tsc": "^1.0.8"
  }
}
