{
  "name": "vue3_template_ts",
  "version": "0.0.0",
  "engines": {
    "node": ">= 16",
    "pnpm": ">= 6"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "preinstall": "node .husky/preinstall.js",
    "prepare": "husky install",
    "lint:eslint": "eslint \"**/**/*.{js,ts,cjs,vue,html,md}\" --fix",
    "lint:stylelint": "stylelint --fix \"**/**/*.(css|scss|vue|html)\" ",
    "lint:lint-staged": "lint-staged -c ./.husky/lintstagedrc.js",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint",
    "commit": "git cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "browserslist": [
    "> 1%",
    "not ie 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@vueuse/core": "^9.4.0",
    "axios": "^1.1.3",
    "dayjs": "^1.11.6",
    "element-plus": "^2.2.19",
    "pinia": "^2.0.23",
    "pinia-plugin-persist": "^1.0.0",
    "vue": "^3.2.41",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.2.0",
    "@iconify-json/ep": "^1.1.8",
    "@iconify-json/noto": "^1.1.5",
    "@playwright/test": "^1.27.1",
    "@types/jsdom": "^20.0.0",
    "@types/node": "^16.18.3",
    "@vitejs/plugin-legacy": "^2.3.0",
    "@vitejs/plugin-vue": "^3.2.0",
    "@vue/test-utils": "^2.2.1",
    "@vue/tsconfig": "^0.1.3",
    "commitizen": "^4.2.5",
    "cz-git": "^1.3.12",
    "eslint": "^8.26.0",
    "eslint-config-zzjtnb": "^0.0.3",
    "eslint-define-config": "^1.11.0",
    "husky": "^8.0.1",
    "jsdom": "^20.0.2",
    "lint-staged": "^13.0.3",
    "npm-run-all": "^4.1.5",
    "stylelint": "^14.14.1",
    "stylelint-config-zzjtnb": "^0.0.1",
    "typescript": "~4.7.4",
    "unplugin-auto-import": "^0.11.4",
    "unplugin-icons": "^0.14.13",
    "unplugin-vue-components": "^0.22.9",
    "vite": "^3.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-inspect": "^0.7.7",
    "vitest": "^0.24.5",
    "vue-tsc": "^1.0.9"
  }
}
