{
  "compilerOptions": {
    "baseUrl": ".",
    // ts的编译的目标es的版本
    "target": "esnext",
    "useDefineForClassFields": true,
    // 模块的版本是 esnext(下一阶段)
    "module": "esnext",
    // 模块的解析 node的模块解析方式
    "moduleResolution": "node",
    //严格的代码检查
    "strict": false,
    //使用的jsx 是转化成怎么的表现形式
    "jsx": "preserve",
    //打包后是否使用资源地图
    "sourceMap": true,
    // 是否支持使用import 来导入json文件
    "resolveJsonModule": true,
    // 是否启动模块化与非模块化的文件的交互
    "esModuleInterop": true,
    // 忽略所有的声明文件(*.d.ts)的类型检查。
    "skipLibCheck": true,
    // 是否显示注释
    "removeComments": false,
    "allowJs": false, //是否对js文件进行编译
    // 每一个文件是否单独编译成一个文件，这个在开发阶段很重要，生产环境设置成false,因为vite是基于每一个文件的改变来进行热更新，如果不开启这个选项，ts 改变后不会自动热更新
    "isolatedModules": true,
    //  减少冗余代码
    "importHelpers": true,
    // 编译过程中需要引入的库文件的列表。
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "noImplicitAny": false,
    "experimentalDecorators": true,
    // 允许从没有设置默认导出的模块中默认导入.这并不影响代码的输出,仅为了类型检查.
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strictFunctionTypes": false,
    "suppressImplicitAnyIndexErrors": true,
    //需要设置成false,否则打包会报错
    "incremental": false,
    // 模块名到基于 baseUrl的路径映射的列表。
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    // 要包含的类型声明文件名列表
    "types": [
      "node",
      "vite/client",
      "element-plus/global"
    ],
    "typeRoots": [
      "node_modules/@types",
      "types"
    ]
  },
  // 这是需要转换的代码目录和文件后缀名
  "include": [
    "vite.config.*",
    "types/*.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
